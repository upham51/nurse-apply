{
  "manifest_version": 3,
  "name": "NurseApply",
  "version": "1.3.0",
  "description": "Autofills nursing job applications on hospital hiring portals. It fills. You review and submit.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkdaysite.com/*",
    "*://*.wd1.myworkdayjobs.com/*",
    "*://*.icims.com/*",
    "*://*.taleo.net/*",
    "*://*.successfactors.com/*",
    "*://*.successfactors.eu/*",
    "*://*.symplr.com/*",
    "*://*.healthcaresource.com/*",
    "*://*.indeed.com/*",
    "*://*.linkedin.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NurseApply",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.successfactors.com/*",
        "*://*.successfactors.eu/*",
        "*://*.symplr.com/*",
        "*://*.healthcaresource.com/*",
        "*://*.indeed.com/*",
        "*://*.linkedin.com/*"
      ],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_idle",
      "js": [
        "src/schema/profile.js",
        "src/lib/storage.js",
        "src/content/domUtils.js",
        "src/content/knockout.js",
        "src/content/heuristics.js",
        "src/content/adapters/base.js",
        "src/content/adapters/workday.js",
        "src/content/adapters/icims.js",
        "src/content/adapters/taleo.js",
        "src/content/adapters/successfactors.js",
        "src/content/adapters/symplr.js",
        "src/content/adapters/linkedin.js",
        "src/content/adapters/indeed.js",
        "src/content/adapters/registry.js",
        "src/content/mapper.js",
        "src/content/hud.js",
        "src/content/index.js"
      ],
      "css": [
        "src/content/hud.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "src/content/hud.css"
      ],
      "matches": [
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.successfactors.com/*",
        "*://*.successfactors.eu/*",
        "*://*.symplr.com/*",
        "*://*.healthcaresource.com/*",
        "*://*.indeed.com/*",
        "*://*.linkedin.com/*"
      ]
    }
  ]
}
